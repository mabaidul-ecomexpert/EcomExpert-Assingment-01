{{ 'section-product-bundle.css' | asset_url | stylesheet_tag }}
{{ 'component-product-price.css' | asset_url | stylesheet_tag }}

<script src="{{ 'section-product-bundle.js' | asset_url }}" type="module"></script>

{%- liquid
  assign review_heading_top = section.settings.review_heading_top
  assign review_heading = section.settings.review_heading
  assign review_subheading = section.settings.review_subheading
  assign checkout_text = section.settings.checkout_text
  assign save_later_text = section.settings.save_later_text
  assign blocks_count = section.blocks.size
-%}

{%- if blocks_count > 0 -%}
  <product-bundle
    data-section-id="{{ section.id }}"
    class="product-bundle section-{{ section.id }}-padding"
  >
    <div class="product-bundle__container">
      <div class="product-bundle__main">
        {%- assign step_icon_names = 'livestream, plan, sensor, protection' | split: ',' -%}
        {%- for block in section.blocks -%}
          {%- assign collection = block.settings.collection -%}
          {%- assign step_title = block.settings.step_title | default: collection.title | default: 'Step' -%}
          {%- assign step_icon_base = step_icon_names[forloop.index0] | default: 'livestream' | strip -%}
          {%- assign step_icon = step_icon_base | append: '.svg' -%}
          <div
            class="product-bundle__step"
            data-step-index="{{ forloop.index0 }}"
            data-block-id="{{ block.id }}"
            {{ block.shopify_attributes }}
          >
            <p class="step">STEP {{ forloop.index }} OF {{ blocks_count }}</p>

            <div
              class="product-bundle__step-header"
              data-step-header
              data-step-toggle
              data-step-index="{{ forloop.index0 }}"
              aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-label="{% if forloop.first %}Collapse step{% else %}Expand step{% endif %}"
            >
              <div class="product-bundle__step-header-left">
                <span class="product-bundle__step-icon" aria-hidden="true">
                  {{- step_icon | inline_asset_content -}}
                </span>
                <h2 class="product-bundle__step-title">
                  {{ step_title }}
                </h2>
              </div>

              <div class="product-bundle__step-header-actions">
                <span class="product-bundle__step-count" data-step-count data-step-index="{{ forloop.index0 }}"> 0 selected </span>
                <button
                  type="button"
                  class="product-bundle__step-toggle"
                >
                  <span class="product-bundle__step-toggle-icon" aria-hidden="true">
                    {%- if forloop.first %}
                      <img src="{{ 'carrot-up.svg' | asset_url }}" alt="Carrot Up Icon" width="12" height="12">
                    {% else %}
                      <img src="{{ 'carrot-down.svg' | asset_url }}" alt="Carrot Down Icon" width="12" height="12">
                    {% endif -%}
                  </span>
                </button>
              </div>
            </div>

            <div
              class="product-bundle__products-panel {% unless forloop.first %}product-bundle__step--collapsed{% endunless %}"
              data-products-panel
              data-step-index="{{ forloop.index0 }}"
            >
              <div class="product-bundle__products-grid" data-products-grid>
                {%- if collection != blank -%}
                  <div class="product-bundle__products-for-collection" data-collection-id="{{ collection.id }}">
                    {%- for product in collection.products limit: 20 -%}
                      {% render 'component-bundle-product-card',
                        product: product,
                        section_id: section.id,
                        block_id: block.id,
                        step_index: forloop.parentloop.index0,
                        step_title: step_title
                      %}
                    {%- endfor -%}
                    {%- if collection.products.size == 0 -%}
                      <p class="product-bundle__empty">No products in this collection.</p>
                    {%- endif -%}
                  </div>
                {%- else -%}
                  <p class="product-bundle__empty">Assign a collection to this step in the theme editor.</p>
                {%- endif -%}
              </div>
              {%- unless forloop.last -%}
                <div class="product-bundle__next-btn--wrapper">
                  <a
                    href="#step-{{ forloop.index }}"
                    class="product-bundle__next-btn button"
                    data-next-step="{{ forloop.index }}"
                  >
                    Next: {{ section.blocks[forloop.index].settings.step_title | default: 'Next step' }}
                  </a>
                </div>
              {%- endunless -%}
            </div>
          </div>
        {%- endfor -%}
      </div>

      <aside class="product-bundle__review" data-review-sidebar>
        <div class="product-bundle__review-header">
          <p class="product-bundle__review-heading-top">{{ review_heading_top }}</p>
          <h3 class="product-bundle__review-heading">{{ review_heading }}</h3>
          <p class="product-bundle__review-subheading">{{ review_subheading }}</p>
        </div>
        <div class="product-bundle__review-items" data-review-items>
          <p class="product-bundle__review-empty" data-review-empty>Add products from the steps to build your bundle.</p>
        </div>

        <div class="product-bundle__review-summary hidden" data-review-summary>
          <div class="product-bundle__review-shipping">
            <div class="product-bundle__review-shipping-title-wrapper">
              <img src="{{ 'Wyze-Sense-Keypad.svg' | asset_url }}" alt="Fast Shipping Icon" width="41" height="41">
              <p class="product-bundle__review-shipping-title">Fast Shipping</p>
            </div>
            <div class="product-bundle__review-shipping-cost-details">
              <span class="product-bundle__review-shipping-cost">$5.99</span>
              <span class="product-bundle__review-shipping-cost-discount">FREE</span>
            </div>
          </div>
          <div class="product-bundle__review-totals">
            <div class="product-bundle__review-total-row product-bundle__review-total-row--final">
              <img src="{{ 'satisfaction-badge.svg' | asset_url }}" alt="Satisfactory Badge Icon" width="78" height="78">
              <span data-total-value>$0.00</span>
            </div>
          </div>
          <button class="product-bundle__checkout-btn button">
            {{ checkout_text }}
          </button>
          <button type="button" class="product-bundle__save-later link" data-save-later>
            {{ save_later_text }}
          </button>
        </div>
      </aside>
    </div>

    <script type="application/json" data-bundle-config>
      {
        "sectionId": {{ section.id | json }},
        "currency": {{ cart.currency.iso_code | json }},
        "moneyFormat": {{ shop.money_format | json }},
        "stepTitles": [
          {%- for block in section.blocks -%}
            {%- assign st = block.settings.step_title | default: block.settings.collection.title | default: 'Step' -%}
            {{ st | json }}{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ],
        "toggleIconUp": {{ 'carrot-up.svg' | asset_url | json }},
        "toggleIconDown": {{ 'carrot-down.svg' | asset_url | json }}
      }
    </script>
  </product-bundle>
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Product Bundle",
  "tag": "section",
  "class": "product-bundle-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Build Your Bundle"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Customize your selection step by step"
    },
    {
      "type": "text",
      "id": "review_heading_top",
      "label": "Review sidebar top",
      "default": "Review"
    },
    {
      "type": "text",
      "id": "review_heading",
      "label": "Review sidebar heading",
      "default": "Your security system"
    },
    {
      "type": "text",
      "id": "review_subheading",
      "label": "Review sidebar subheading",
      "default": "Review your personalized protection system designed to keep what matters most safe."
    },
    {
      "type": "text",
      "id": "checkout_text",
      "label": "Checkout button text",
      "default": "Checkout"
    },
    {
      "type": "text",
      "id": "save_later_text",
      "label": "Save for later link text",
      "default": "Save my system for later"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "collection_step",
      "name": "Collection Step",
      "limit": 4,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Select one of the 4 collections for this step. Each step has its own collection."
        },
        {
          "type": "text",
          "id": "step_title",
          "label": "Step title",
          "info": "e.g. Choose your cameras. Overrides collection title if set."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Bundle",
      "blocks": [
        { "type": "collection_step", "settings": { "step_title": "Choose your cameras" } },
        { "type": "collection_step", "settings": { "step_title": "Choose your plan" } },
        { "type": "collection_step", "settings": { "step_title": "Choose your sensors" } },
        { "type": "collection_step", "settings": { "step_title": "Add extra protection" } }
      ]
    }
  ]
}
{% endschema %}
